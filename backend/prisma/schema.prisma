datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum InvoiceStatus {
  PENDING
  PROCESSING
  SUBMITTED
  FAILED
}

enum LogLevel {
  INFO
  WARN
  ERROR
}

enum FailureType {
  RETRYABLE
  PERMANENT
}

model Company {
  id        String    @id @default(uuid())
  name      String
  taxId     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  invoices  Invoice[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Invoice {
  id            String         @id @default(uuid())
  companyId     String
  invoiceNumber String
  invoiceDate   DateTime
  customerName  String
  customerTaxId String
  customerEmail String
  currency      String         @default("USD")
  subtotal      Decimal        @db.Decimal(12, 2)
  taxAmount     Decimal        @db.Decimal(12, 2)
  totalAmount   Decimal        @db.Decimal(12, 2)
  status        InvoiceStatus  @default(PENDING)

  // Retry and queue columns (Part H and L). The invoices table is the work queue.
  failureType   FailureType?   // set only while status is FAILED
  attemptCount  Int            @default(0)
  maxAttempts   Int            @default(8)
  nextRetryAt   DateTime?      // when the worker may claim this row next
  lockedUntil   DateTime?      // lease set by the worker while PROCESSING

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]
  logs          ProcessingLog[]

  // Solves C2 & C3: Hard database-level guarantee preventing duplicate invoice creation per company
  @@unique([companyId, invoiceNumber])
  @@index([companyId, status])
  @@index([companyId, invoiceDate])
  @@index([status, nextRetryAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)
  tax         Decimal  @db.Decimal(12, 2)
  lineTotal   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model ProcessingLog {
  id        String   @id @default(uuid())
  invoiceId String
  level     LogLevel @default(INFO)
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  // One row per processing attempt (Part L). Rows without an attemptNumber are plain events.
  attemptNumber    Int?
  startedAt        DateTime?
  endedAt          DateTime?
  httpStatus       Int?
  errorMessage     String?
  processingStatus InvoiceStatus?

  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // NULL attempt numbers do not collide in PostgreSQL, so event rows are unaffected.
  @@unique([invoiceId, attemptNumber])
  @@index([invoiceId])
  @@map("processing_logs")
}