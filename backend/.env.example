PORT=4000
NODE_ENV=development
DATABASE_URL=<ADD-LOCAL-DATABASE_URL>
# Required, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=<GENERATE-A-LONG-RANDOM-SECRET>
JWT_EXPIRES_IN="1d"

# Worker and retry settings (optional, these are the defaults)
MAX_RETRY_ATTEMPTS=8
RETRY_BASE_DELAY_SECONDS=60
RETRY_MAX_DELAY_SECONDS=900
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=5
# Must be longer than GOVERNMENT_API_TIMEOUT_MS / 1000
WORKER_LOCK_SECONDS=60
GOVERNMENT_API_TIMEOUT_MS=10000
