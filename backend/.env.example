# Copy this file to the env file for the environment you are running. Never commit the copies.
#
#   .env.development  -> used when NODE_ENV=development (npm run dev). Points at the tubo-dev Supabase project.
#   .env.production   -> used when NODE_ENV=production (npm start). Points at the tubo-prod Supabase project.
#
# Variables set in the real process environment (for example in Vercel's settings) override the file.
# All variables are validated at startup. The app refuses to start if any is missing or invalid.

# development | production | test. The npm scripts set this for you.
NODE_ENV=development

# Port for local runs. Optional, defaults to 3000.
PORT=3000

# Supabase project settings: Project Settings -> API in the Supabase dashboard.
SUPABASE_URL=https://your-project-ref.supabase.co
# Server-side only. Never put this in the frontend or in a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Government invoicing API, or the mock (D12). The mock is added in M4.
GOVERNMENT_API_BASE_URL=http://localhost:3001

# Protects the Vercel Cron endpoint. At least 16 characters, for example: openssl rand -hex 32
CRON_SECRET=replace-with-a-random-string-of-16-or-more-characters
