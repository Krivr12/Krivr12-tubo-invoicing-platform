# Copy this file to the env file for the environment you are running. Never commit the copies.
#
#   .env.development  -> loaded by `npm run dev`.   Points at the tubo-dev Supabase project.
#   .env.production   -> loaded by `npm run build`. Points at the tubo-prod Supabase project.
#
# Variables set in the real process environment (for example in Vercel's settings) override the file.
#
# Everything here ends up in the public browser bundle. Only VITE_ variables are exposed.
# Never add a service-role key or any other secret to this file.

# Supabase project settings: Project Settings -> API in the Supabase dashboard.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon (public) key. Row Level Security protects the data.
VITE_SUPABASE_ANON_KEY=replace-with-anon-key

# Base URL of the Tubo API (the backend). Local backend default shown.
VITE_API_BASE_URL=http://localhost:3000
